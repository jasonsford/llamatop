# Rust build artifacts
target/
**/*.rs.bk
*.pdb

# Cargo local state (keep Cargo.lock tracked for binary crates)
.cargo/config.toml.local
.cargo/*.local

# Local credentials, certificates, and diagnostics
.env
.env.*
!.env.example
server.env
*.pem
*.key
*.log
*.log.*

# Local SSH keys and connection state
.ssh/
id_rsa
id_rsa.pub
id_dsa
id_dsa.pub
id_ecdsa*
id_ed25519*
ssh_host_*_key
ssh_host_*_key.pub
*.ppk
authorized_keys
known_hosts

# OS & Filesystem metadata
.DS_Store
._*
Thumbs.db
desktop.ini

# IDE & Editor state
.idea/
.vscode/
*.swp
*.swo
*~

# AI agent & assistant state
.claude/
.codex/
.opencode/

# Crash dumps & profiling artifacts
core
core.*
vgcore.*
perf.data
perf.data.old

__pycache__/
*.py[cod]
*$py.class